<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="FinWise.AI provides financial research, market insights, and financial education.">
    <title>FinWise.AI | Smarter Financial Insights</title>
    <style>
        :root {
            --navy: #090d14;
            --navy-light: #101b27;
            --card: #121a25;
            --green: #a78bfa;
            --green-dark: #7c3aed;
            --white: #f5f8fc;
            --muted: #a9b8ca;
            --border: rgba(255,255,255,0.12);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--navy);
            color: var(--white);
            line-height: 1.6;
        }

        a { color: inherit; text-decoration: none; }

        .container {
            width: min(1120px, 90%);
            margin: 0 auto;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(11, 23, 40, 0.96);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(12px);
        }

        .navbar {
            min-height: 76px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: 0.2px;
        }

        .brand-mark {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--green);
            color: var(--navy);
            font-size: 1.4rem;
            font-weight: 900;
        }

        nav { display: flex; align-items: center; gap: 25px; }

        nav a {
            color: var(--muted);
            font-size: 0.93rem;
            transition: color 0.2s ease;
        }

        nav a:hover, nav a:focus { color: var(--green); }

        .nav-cta, .button {
            display: inline-block;
            background: var(--green);
            color: var(--navy);
            font-weight: 800;
            padding: 12px 19px;
            border-radius: 9px;
            border: 0;
            cursor: pointer;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .nav-cta:hover, .button:hover {
            background: #c4b5fd;
            transform: translateY(-2px);
        }

        .hero {
            padding: 92px 0 76px;
            background:
                radial-gradient(circle at 82% 24%, rgba(181,140,255,0.14), transparent 27%),
                linear-gradient(135deg, #08070D 20%, #171022 100%);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            align-items: center;
            gap: 56px;
        }

        .owner-credit {
            display: inline-flex; align-items: center; gap: 9px; margin: 15px 0 2px;
            padding: 8px 12px; border: 1px solid rgba(181,140,255,.5);
            border-radius: 7px; background: rgba(124,58,237,.14); color: #c9b7ff;
            font-size: .72rem; font-weight: 800; letter-spacing: 1.2px;
        }
        .owner-credit strong { color: #fff; font-size: .84rem; letter-spacing: 1.5px; }
        .owner-email a { color: #c9b7ff; text-decoration: underline; text-underline-offset: 3px; }

        .eyebrow {
            color: var(--green);
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        h1 {
            font-size: clamp(2.5rem, 5vw, 4.3rem);
            line-height: 1.08;
            margin: 18px 0;
            letter-spacing: -1.8px;
        }

        h1 span { color: var(--green); }

        .hero-copy, .section-copy {
            color: var(--muted);
            max-width: 620px;
            font-size: 1.05rem;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 28px;
        }

        .button-secondary {
            display: inline-block;
            padding: 11px 18px;
            border: 1px solid var(--border);
            border-radius: 9px;
            font-weight: 700;
        }

        .button-secondary:hover { border-color: var(--green); color: var(--green); }

        .trust-note {
            margin-top: 25px;
            font-size: 0.86rem;
            color: var(--muted);
        }

        .dashboard {
            background: rgba(20,40,64,0.92);
            border: 1px solid var(--border);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.25);
        }

        .dashboard-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .dashboard-top p { color: var(--muted); font-size: 0.88rem; }

        .demo-label {
            font-size: 0.7rem;
            color: var(--green);
            border: 1px solid rgba(181,140,255,0.42);
            padding: 4px 8px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .market-value { font-size: 2.1rem; font-weight: 800; }

        .positive { color: var(--green); font-size: 0.9rem; font-weight: 700; }

        .chart {
            height: 135px;
            margin: 20px 0;
            display: flex;
            align-items: end;
            gap: 9px;
            border-bottom: 1px solid var(--border);
            padding: 0 5px;
        }

        .bar {
            flex: 1;
            min-width: 8px;
            border-radius: 5px 5px 0 0;
            background: linear-gradient(180deg, var(--green), rgba(181,140,255,0.16));
        }

        .market-mini-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .mini-card {
            padding: 13px;
            background: rgba(255,255,255,0.035);
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        .mini-card p { color: var(--muted); font-size: 0.8rem; }
        .mini-card strong { display: block; margin: 4px 0; font-size: 1.08rem; }

        section { padding: 78px 0; }

        .section-heading {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 42px;
        }

        .section-heading h2 {
            font-size: clamp(1.9rem, 4vw, 2.7rem);
            line-height: 1.2;
            margin: 12px 0;
        }

        .section-heading p { color: var(--muted); }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .service-card {
            padding: 0 0 27px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 15px;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .service-image { width: 100%; height: 150px; object-fit: cover; display: block; margin-bottom: 22px; filter: saturate(.78) contrast(1.05); }
        .service-card .service-icon, .service-card h3, .service-card p { margin-left: 25px; margin-right: 25px; }
        .service-card:hover {
            transform: translateY(-5px);
            border-color: rgba(181,140,255,0.68);
        }

        .service-icon {
            display: grid;
            place-items: center;
            width: 48px;
            height: 48px;
            background: rgba(181,140,255,0.13);
            border-radius: 12px;
            font-size: 1.5rem;
            margin-bottom: 18px;
        }

        .service-card h3 { margin-bottom: 9px; font-size: 1.15rem; }
        .service-card p { color: var(--muted); font-size: 0.94rem; }

        .about { background: #0d1420; }

        .about-grid {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 55px;
            align-items: center;
        }

        .about-panel {
            padding: 30px;
            border-radius: 18px;
            border: 1px solid var(--border);
            background: linear-gradient(145deg, #211632, #0d1420);
        }

        .about-panel h3 { font-size: 1.5rem; margin-bottom: 12px; }
        .about-panel p { color: var(--muted); }

        .values-list {
            list-style: none;
            margin-top: 20px;
            display: grid;
            gap: 12px;
        }

        .values-list li::before {
            content: "✓";
            color: var(--green);
            font-weight: 900;
            margin-right: 10px;
        }

        .about-text h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 12px 0 18px; }
        .about-text p { color: var(--muted); margin-bottom: 14px; }

        .market-table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 13px;
        }

        table { width: 100%; border-collapse: collapse; min-width: 520px; }

        th, td { padding: 17px 20px; text-align: left; border-bottom: 1px solid var(--border); }
        th { background: var(--card); color: var(--muted); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.6px; }
        td { color: var(--white); }
        tbody tr:last-child td { border-bottom: 0; }
        tbody tr:hover { background: rgba(255,255,255,0.025); }

        .contact { background: #0d1420; }

        .contact-grid {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            gap: 45px;
        }

        .contact-info h2 { font-size: 2.3rem; line-height: 1.2; margin: 12px 0 17px; }
        .contact-info p { color: var(--muted); margin-bottom: 18px; }

        .contact-card {
            margin-top: 25px;
            padding: 18px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: rgba(255,255,255,0.025);
        }

        .contact-card strong { display: block; margin-bottom: 4px; }
        .contact-card span { color: var(--muted); }

        form {
            padding: 28px;
            border: 1px solid var(--border);
            background: var(--card);
            border-radius: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        label { display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 7px; }

        input, select, textarea {
            width: 100%;
            padding: 12px 13px;
            margin-bottom: 17px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #0D0A14;
            color: var(--white);
            font: inherit;
        }

        input:focus, select:focus, textarea:focus {
            outline: 2px solid var(--green);
            outline-offset: 1px;
        }

        textarea { resize: vertical; min-height: 115px; }
        form .button { width: 100%; font-size: 1rem; }

        .form-note { color: var(--muted); font-size: 0.78rem; margin-top: 12px; }

        .whatsapp-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 18px;
            padding: 13px 19px;
            border-radius: 9px;
            background: #25D366;
            color: #062b15;
            font-weight: 800;
            transition: transform 0.2s ease, background 0.2s ease;
        }
        .whatsapp-button:hover { background: #51e184; transform: translateY(-2px); }
        .whatsapp-contact-link { color: #25D366; font-weight: 700; }


        footer {
            padding: 25px 0;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 0.86rem;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
        }

        @media (max-width: 850px) {
            .hero-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
            .hero { padding-top: 65px; }
            .services-grid { grid-template-columns: repeat(2, 1fr); }
            .hero-grid { gap: 38px; }
        }

        @media (max-width: 600px) {
            .navbar { padding: 15px 0; align-items: flex-start; flex-direction: column; gap: 14px; }
            nav { width: 100%; gap: 15px; flex-wrap: wrap; }
            nav a { font-size: 0.85rem; }
            .nav-cta { display: none; }
            .hero { padding: 52px 0; }
            section { padding: 58px 0; }
            .services-grid, .form-row { grid-template-columns: 1fr; }
            .dashboard { padding: 18px; }
            h1 { letter-spacing: -1px; }
            .about-grid, .contact-grid { gap: 30px; }
            th, td { padding: 13px; }
        }
    </style>
</head>
